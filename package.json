  "description": "Create unique generative landscapes",
  "keywords": [
    "generative",
    "art",
    "landscape"
  ],
  "homepage": "https://landscapejs.github.io",
  "bugs": {
    "url": "https://github.com/landscapejs/landscapejs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/landscapejs/landscapejs.git"
  },
  "license": "ISC",
  "author": "Binary Star Studio",
  "type": "module",
  "files": [
    "dist/lib"
  ],
  "main": "dist/lib/landscape.js",
  "exports": {
    ".": {
      "import": "./dist/lib/landscape.js",
      "require": "./dist/lib/landscape.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.lib.config.ts && vite build",
    "preview": "vite preview",
    "publish": "vite build && node updateVersion.js && ./publish.sh"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "daisyui": "^5.5.19",
    "tailwindcss": "^4.2.1",
    "terser": "^5.46.1",
    "vite": "^7.2.4",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-html": "^3.2.2",
    "@tailwindplus/elements": "^1.0.22",
    "lz-string": "^1.5.0"
  },
  "dependencies": {}
}